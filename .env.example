# ------------------------------------------------------------------
# VarianceAI – Konfiguration (Vorlage)
# Kopieren nach `.env` und Werte eintragen. `.env` niemals einchecken.
# Ohne API-Key läuft das Projekt vollständig im Mock-/Offline-Modus.
# ------------------------------------------------------------------

# LLM-Anbieter: mock | claude | gemini
LLM_ANBIETER=mock

# --- Anthropic Claude ---
# Aktuelle Modell-IDs: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Gemini ---
# Aktuelle Modell-IDs: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agent-Verhalten ---
LLM_MAX_TOKENS=1024
# Leer lassen = Standard des Modells (manche Modelle akzeptieren keinen Wert)
LLM_TEMPERATUR=
AGENT_MAX_TOOL_AUFRUFE=8

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
